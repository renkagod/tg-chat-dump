# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Chat to dump: numeric id, @username or t.me link (can be overridden with --chat)
TG_CHAT=

# Optional SOCKS5/HTTP proxy, e.g. when Telegram is blocked in your network
# TG_PROXY=socks5://127.0.0.1:1080

# Folder for the dumps (default: out/ next to dump.py)
# TG_OUT=D:\Telegram dumps

# Extras, comma-separated: meta, markdown, comments, bio, who, files, takeout, html, csv, tdesktop
# (default: takeout,html; none turns them all off)
# TG_OPTIONS=takeout,html,meta

# What the files extra downloads: the largest file in megabytes (0: any size), and the types:
# photos, videos, gifs, voice, round, music, docs, stickers, or all
# TG_FILE_SIZE=20
# TG_FILE_TYPES=photos,videos,gifs,voice,round,music,docs

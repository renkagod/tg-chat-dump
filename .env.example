# Get these at https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Chat to dump: numeric id, @username or t.me link (can be overridden with --chat)
TG_CHAT=

# Optional SOCKS5/HTTP proxy, e.g. when Telegram is blocked in your network
# TG_PROXY=socks5://127.0.0.1:1080

# Folder for the dumps (default: out/ next to dump.py)
# TG_OUT=D:\Telegram dumps

# Extras, comma-separated: meta, polls, markdown, comments, takeout (default: takeout; none turns them all off)
# TG_OPTIONS=takeout,meta,polls
